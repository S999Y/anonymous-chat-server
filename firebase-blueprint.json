{
  "entities": {
    "Room": {
      "title": "Chat Room",
      "description": "A temporary chat room identified by a 4-character code.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "4-character unique code for the room."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "lastActivity": {
          "type": "string",
          "format": "date-time",
          "description": "Last message timestamp."
        }
      },
      "required": ["code", "createdAt"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "A message sent within a chat room.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The message content (up to 50k chars)."
        },
        "senderId": {
          "type": "string",
          "description": "Anonymous unique ID of the sender."
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender."
        },
        "senderColor": {
          "type": "string",
          "description": "Display color of the sender."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-side creation timestamp."
        },
        "readBy": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of user IDs who have read this message."
        },
        "file": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "description": "Original file name (1-260 chars)." },
            "type": { "type": "string", "description": "MIME type." },
            "size": { "type": "integer", "description": "Total file size in bytes (max 20 MB)." },
            "fileId": { "type": "string", "description": "Unique identifier for this file." },
            "totalParts": { "type": "integer", "description": "Number of chunks the file was split into." },
            "partSize": { "type": "integer", "description": "Byte size of each chunk (700 KB)." },
            "masterHash": { "type": "string", "description": "SHA-256 checksum of the whole file." }
          },
          "description": "Metadata for an attached file. The actual data is stored as base64 chunks in the 'parts' subcollection."
        }
      },
      "required": ["senderId", "senderName", "createdAt"]
    },
    "FilePart": {
      "title": "File Chunk",
      "description": "A single base64-encoded chunk of a split file.",
      "type": "object",
      "properties": {
        "index": { "type": "integer", "description": "1-based index of the chunk." },
        "data": { "type": "string", "description": "Base64-encoded chunk of the file." }
      },
      "required": ["index", "data"]
    },
    "Inbox": {
      "title": "Anonymous Inbox",
      "description": "Configuration for a user's anonymous message receiver.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "username": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "username", "createdAt"]
    },
    "InboxMessage": {
      "title": "Anonymous Inbox Message",
      "description": "An anonymous message sent to a user's inbox.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "readBy": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of user IDs who have read this message."
        }
      },
      "required": ["text", "senderId", "createdAt"]
    }
  },
  "firestore": {
    "/rooms/{roomCode}": {
      "schema": "Room",
      "description": "Storage for chat room metadata."
    },
    "/rooms/{roomCode}/messages/{messageId}": {
      "schema": "Message",
      "description": "Storage for messages within a specific room."
    },
    "/rooms/{roomCode}/messages/{messageId}/parts/{partIndex}": {
      "schema": "FilePart",
      "description": "Base64-encoded chunks of a file attached to a room message."
    },
    "/inboxes/{userId}": {
      "schema": "Inbox",
      "description": "User's anonymous inbox configuration."
    },
    "/inboxes/{userId}/messages/{messageId}": {
      "schema": "InboxMessage",
      "description": "Messages received via the anonymous public link."
    }
  }
}
